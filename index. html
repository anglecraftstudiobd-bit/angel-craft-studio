<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Angel Craft Studio</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#fff8fc;color:#493342}
header{background:#f7d6e8;padding:22px;text-align:center}
header h1{color:#b34e82;margin:0}
nav{padding:15px;text-align:center}
nav a{margin:10px;color:#a33c70;text-decoration:none}
.hero{text-align:center;padding:65px 20px;background:#fff0f7}
.hero h2{font-size:32px;color:#b34e82}
.hero p{font-size:17px}
.btn{background:#c45c91;color:white;padding:12px 25px;border-radius:25px;text-decoration:none;display:inline-block}
section{padding:35px 20px;text-align:center}
.products{display:flex;justify-content:center;flex-wrap:wrap;gap:20px}
.product{background:white;padding:20px;border-radius:15px;width:220px;box-shadow:0 2px 10px #ead5e0}
footer{background:#f7d6e8;text-align:center;padding:20px}
</style>
</head>
<body>
<header>
<h1>Angel Craft Studio 🪽</h1>
<p>Handmade with Love</p>
</header>
<nav>
<a href="#home">Home</a>
<a href="#products">Products</a>
<a href="#contact">Contact</a>
</nav>
<div class="hero" id="home">
<h2>Beautiful Handmade Crafts</h2>
<p>Unique creations, made with love just for you.</p>
<a class="btn" href="#products">Explore Collection</a>
</div>
<section id="products">
<h2>Our Collection</h2>
<div class="products">
<div class="product"><h3>Handmade Crafts</h3><p>Beautiful handmade creations.</p></div>
<div class="product"><h3>Special Gifts</h3><p>Unique gifts for special moments.</p></div>
<div class="product"><h3>Custom Orders</h3><p>Made specially for you.</p></div>
</div>
</section>
<section id="contact">
<h2>Contact Us</h2>
<p>Order your favourite handmade crafts.</p>
<a class="btn" href="https://wa.me/">WhatsApp Order</a>
</section>
<footer>
<p>© 2026 Angel Craft Studio</p>
<p>Made with Love 🩷</p>
</footer>
</body>
</html>
